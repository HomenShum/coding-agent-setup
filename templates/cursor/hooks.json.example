{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python scripts/self_review_hook.py --host cursor --event session-start",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "python scripts/self_review_hook.py --host cursor --event pre-compact",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "python scripts/self_review_hook.py --host cursor --event stop",
        "timeout": 5,
        "loop_limit": 5
      }
    ]
  }
}
