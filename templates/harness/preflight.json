{
  "configured": true,
  "checks": {
    "convention_sync": {
      "rules": [
        {
          "contains": [
            "@../AGENTS.md"
          ],
          "path": ".claude/CLAUDE.md"
        },
        {
          "contains": [
            "## Verification"
          ],
          "path": "AGENTS.md"
        }
      ]
    },
    "runtime": {
      "imports": [
        "ast",
        "json",
        "pathlib"
      ],
      "minimum_python": "3.11",
      "probe_timeout_seconds": 5
    },
    "self_review": {
      "artifact": "self-review",
      "paths": [
        "scripts/agent_preflight.py",
        "scripts/bounded_process.py",
        "scripts/git_safety.py",
        "scripts/path_safety.py",
        "scripts/prove_preflight_mutations.py",
        "templates/harness/hook-admission.json",
        "templates/harness/preflight.json",
        "templates/harness/shape-version.json",
        "tests/test_preflight_mutations.py"
      ],
      "receipt": "templates/harness/self-review.json"
    },
    "selftests": {
      "commands": [
        {
          "argv": [
            "{python}",
            "scripts/prove_preflight_mutations.py"
          ],
          "timeout_seconds": 60
        }
      ]
    },
    "shape_version": {
      "pairs": [
        {
          "receipt": "templates/harness/self-review.json",
          "schema": "templates/harness/shape-version.json"
        }
      ]
    },
    "silent_handlers": {
      "patterns": [
        "scripts/agent_preflight.py"
      ]
    },
    "visual": {
      "mode": "not_applicable",
      "reason": "This repository publishes text and configuration files and has no rendered user interface."
    }
  },
  "version": 2
}
